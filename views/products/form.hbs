<div class="mb-3">
  <a href="/products" class="btn btn-secondary">&larr; Kembali</a>
</div>

<div class="card" style="max-width: 700px; margin: 0 auto;">
  <div class="card-header">
    <div>
      <h2 class="card-title">
        {{#if isEdit}}Edit Produk{{else}}Tambah Produk{{/if}}
      </h2>
    </div>
  </div>

  <form id="productForm">
    <div class="form-grid">
      <div class="form-group">
        <label for="sku" class="form-label">
          Kode SKU <span class="required">*</span>
        </label>
        <input
          type="text"
          id="sku"
          name="sku"
          value="{{product.sku}}"
          required
          placeholder="Kode SKU"
          class="form-control"
          style="font-family: monospace;"
        />
      </div>

      <div class="form-group">
        <label for="name" class="form-label">
          Nama Produk <span class="required">*</span>
        </label>
        <input
          type="text"
          id="name"
          name="name"
          value="{{product.name}}"
          required
          placeholder="Nama Produk"
          class="form-control"
        />
      </div>
    </div>

    <div class="form-group">
      <label for="categoryId" class="form-label">
        Kategori <span class="required">*</span>
      </label>
      <select id="categoryId" name="categoryId" required class="form-control">
        <option value="">Pilih Kategori</option>
        {{#each categories}}
        <option value="{{this.id}}" {{#if (eq this.id ../product.categoryId)}}selected{{/if}}>
          {{this.name}}
        </option>
        {{/each}}
      </select>
    </div>

    <div class="form-grid">
      <div class="form-group">
        <label for="price" class="form-label">
          Harga (Rp) <span class="required">*</span>
        </label>
        <input
          type="number"
          id="price"
          name="price"
          min="0"
          step="1000"
          value="{{#if product.price}}{{product.price}}{{else}}0{{/if}}"
          required
          class="form-control"
        />
      </div>

      <div class="form-group">
        <label for="stock" class="form-label">
          Stok <span class="required">*</span>
        </label>
        <input
          type="number"
          id="stock"
          name="stock"
          min="0"
          value="{{#if product.stock}}{{product.stock}}{{else}}0{{/if}}"
          required
          class="form-control"
        />
      </div>
    </div>

    <div class="form-group">
      <label for="description" class="form-label">
        Deskripsi
      </label>
      <textarea
        id="description"
        name="description"
        placeholder="Deskripsi"
        class="form-control"
      >{{product.description}}</textarea>
    </div>

    <div class="d-flex justify-between align-center mt-4">
      <a href="/products" class="btn btn-secondary">Batal</a>
      <button type="submit" id="submitBtn" class="btn btn-primary">
        Simpan
      </button>
    </div>
  </form>
</div>

<script>
  const form = document.getElementById('productForm');
  const isEdit = {{#if isEdit}}true{{else}}false{{/if}};
  const productId = {{#if isEdit}}{{product.id}}{{else}}null{{/if}};

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    const submitBtn = document.getElementById('submitBtn');
    submitBtn.disabled = true;
    submitBtn.innerText = 'Menyimpan...';

    const payload = {
      sku: document.getElementById('sku').value.trim(),
      name: document.getElementById('name').value.trim(),
      categoryId: parseInt(document.getElementById('categoryId').value, 10),
      price: parseFloat(document.getElementById('price').value),
      stock: parseInt(document.getElementById('stock').value, 10),
      description: document.getElementById('description').value.trim(),
    };

    const targetUrl = isEdit ? `/products/${productId}` : '/products';
    const httpMethod = isEdit ? 'PUT' : 'POST';

    try {
      const res = await fetch(targetUrl, {
        method: httpMethod,
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
        },
        body: JSON.stringify(payload),
      });

      const data = await res.json();

      if (res.ok) {
        const msg = isEdit ? 'Produk berhasil diperbarui.' : 'Produk berhasil ditambahkan.';
        window.location.href = '/products?success=' + encodeURIComponent(msg);
      } else {
        alert('Gagal: ' + (data.message || 'Terjadi kesalahan'));
        submitBtn.disabled = false;
        submitBtn.innerText = 'Simpan';
      }
    } catch (err) {
      alert('Gagal menghubungi server.');
      submitBtn.disabled = false;
      submitBtn.innerText = 'Simpan';
    }
  });
</script>
